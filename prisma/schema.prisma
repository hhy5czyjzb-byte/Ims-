// Datamodel IMS Rouwmaat Groep
// Code-identifiers zijn Engels; de interface is Nederlands (zie src/lib/labels.ts).
// Kernprincipe: één bewijsstuk (document, proces, risico, audit, actie) kan aan
// meerdere normeisen van meerdere normen gekoppeld worden.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Gebruikers, rollen en stamgegevens
// ─────────────────────────────────────────────────────────────

/// Rol wordt bij elke login afgeleid uit Entra ID-groepen; hier alleen gecachet.
enum Role {
  QHSE
  DIRECTIE
  MIDDENKADER
}

model User {
  id            String       @id @default(cuid())
  entraObjectId String?      @unique
  email         String       @unique
  name          String
  role          Role         @default(MIDDENKADER)
  jobFunctionId String?
  jobFunction   JobFunction? @relation(fields: [jobFunctionId], references: [id], onDelete: SetNull)
  active        Boolean      @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  ownedActions             Action[]               @relation("ActionOwner")
  createdActions           Action[]               @relation("ActionCreatedBy")
  ownedProcesses           Process[]              @relation("ProcessOwner")
  ownedDocuments           Document[]             @relation("DocumentOwner")
  ownedRisks               Risk[]                 @relation("RiskOwner")
  ownedLegalRequirements   LegalRequirement[]     @relation("LegalOwner")
  createdLegalRequirements LegalRequirement[]     @relation("LegalCreatedBy")
  complianceAssessments    ComplianceAssessment[]
  ownedAspects             EnvironmentalAspect[]  @relation("AspectOwner")
  createdAspects           EnvironmentalAspect[]  @relation("AspectCreatedBy")
  settingsChanged          AppSetting[]
  createdConsumptions      EnergyConsumption[]
  createdRisks             Risk[]                 @relation("RiskCreatedBy")
  ownedObjectives          Objective[]            @relation("ObjectiveOwner")
  objectiveReviews         ObjectiveReview[]
  approvedReviews          ManagementReview[]     @relation("ReviewApprovedBy")
  createdReviews           ManagementReview[]     @relation("ReviewCreatedBy")
  ownedStakeholders        Stakeholder[]          @relation("StakeholderOwner")
  raciAssignments          RaciAssignment[]
  supplierEvaluations      SupplierEvaluation[]
  auditLogs                AuditLog[]
  locationAuditsAsAuditor  LocationAudit[]        @relation("LocationAuditAuditor")
  approvedContextAnalyses  ContextAnalysis[]      @relation("ContextApprovedBy")
  reportedReports          Report[]               @relation("ReportReportedBy")
  ownedReports             Report[]               @relation("ReportOwner")
  uploadedContextAnalyses  ContextAnalysis[]      @relation("ContextUploadedBy")
  createdLocationAudits    LocationAudit[]        @relation("LocationAuditCreatedBy")
}

/// Vestiging/locatie: vast kenmerk in het hele systeem.
model Location {
  id                     String   @id @default(cuid())
  name                   String   @unique
  address                String?
  city                   String? // plaats / gemeente
  activities             String? // activiteiten op de locatie
  energySavingObligation String? // boven drempel energiebesparingsplicht: Ja / Nee / Nog bepalen
  kind                   String? // soort: vestiging, betoncentrale, kantoor, werkplaats, depot, …
  postalCode             String?
  managerText            String? // vestigingsmanager / contactpersoon
  permitInfo             String? // omgevingsvergunning en meldingen
  notes                  String?
  active                 Boolean  @default(true)
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  actions              Action[]
  risks                Risk[]
  legalRequirements    LegalRequirement[]
  environmentalAspects EnvironmentalAspect[]
  equipment            Equipment[]
  energyConsumptions   EnergyConsumption[]
  audits               Audit[]
  locationAudits       LocationAudit[]
  reports              Report[]
}

/// Discipline: prefab, beton, afvalrecycling, infra (uitbreidbaar).
model Discipline {
  id          String   @id @default(cuid())
  name        String   @unique
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  description String?
  managerText String? // BU-manager / directeur
  aliases     String[] @default([]) // andere schrijfwijzen in Excel-registers (bijv. "Afval & Recycling"), gebruikt bij import
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  processes            Process[]
  actions              Action[]
  risks                Risk[]                @relation("RiskDisciplines")
  legalRequirements    LegalRequirement[]
  environmentalAspects EnvironmentalAspect[]
  equipment            Equipment[]
  energyConsumptions   EnergyConsumption[]
  reductionTargets     ReductionTarget[]
  audits               Audit[]
  suppliers            Supplier[]
  reports              Report[]
  objectives           Objective[]
}

/// Functie (bijv. Uitvoerder, QHSE-coördinator) — gebruikt in RACI.
model JobFunction {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  raciAssignments RaciAssignment[]
}

// ─────────────────────────────────────────────────────────────
// Normenkader
// ─────────────────────────────────────────────────────────────

enum NormCategory {
  QUALITY
  ENVIRONMENT
  SAFETY
  CO2
  PRODUCT
  OTHER
}

model Norm {
  id          String       @id @default(cuid())
  code        String       @unique // bijv. "ISO 9001"
  name        String
  version     String? // bijv. "2015"
  category    NormCategory @default(OTHER)
  description String?
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  requirements      NormRequirement[]
  audits            Audit[]            @relation("AuditNorms")
  legalRequirements LegalRequirement[] @relation("LegalNorms")
  objectives        Objective[]        @relation("ObjectiveNorms")
}

/// Eis of hoofdstuk van een norm. Hiërarchisch via parentId.
model NormRequirement {
  id          String            @id @default(cuid())
  normId      String
  norm        Norm              @relation(fields: [normId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      NormRequirement?  @relation("RequirementTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    NormRequirement[] @relation("RequirementTree")
  clause      String // bijv. "7.5.3"
  title       String
  description String?
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  documents            Document[]            @relation("DocumentRequirements")
  legalRequirements    LegalRequirement[]    @relation("LegalNormRequirements")
  environmentalAspects EnvironmentalAspect[] @relation("AspectNormRequirements")
  processes            Process[]             @relation("ProcessRequirements")
  processSteps         ProcessStep[]         @relation("StepRequirements")
  risks                Risk[]                @relation("RiskRequirements")
  actions              Action[]              @relation("ActionRequirements")
  findings             AuditFinding[]
  checklistItems       AuditChecklistItem[]
  reports              Report[]              @relation("ReportRequirements")
  objectives           Objective[]           @relation("ObjectiveRequirements")

  @@unique([normId, clause])
  @@index([normId, sortOrder])
}

// ─────────────────────────────────────────────────────────────
// Processen, processtappen en RACI
// ─────────────────────────────────────────────────────────────

model Process {
  id           String      @id @default(cuid())
  code         String?     @unique
  name         String
  description  String?
  purpose      String?
  input        String?
  output       String?
  disciplineId String?
  discipline   Discipline? @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  ownerId      String?
  owner        User?       @relation("ProcessOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  sortOrder    Int         @default(0)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  steps                ProcessStep[]
  documents            Document[]            @relation("ProcessDocuments")
  requirements         NormRequirement[]     @relation("ProcessRequirements")
  risks                Risk[]                @relation("RiskProcesses")
  legalRequirements    LegalRequirement[]    @relation("LegalProcesses")
  environmentalAspects EnvironmentalAspect[] @relation("AspectProcesses")
  reports              Report[]
}

model ProcessStep {
  id          String   @id @default(cuid())
  processId   String
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  sortOrder   Int      @default(0)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  raci         RaciAssignment[]
  documents    Document[]        @relation("StepDocuments")
  requirements NormRequirement[] @relation("StepRequirements")

  @@index([processId, sortOrder])
}

enum RaciType {
  R
  A
  C
  I
}

/// RACI-toewijzing per processtap, aan een functie óf een persoon.
model RaciAssignment {
  id            String       @id @default(cuid())
  stepId        String
  step          ProcessStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  type          RaciType
  jobFunctionId String?
  jobFunction   JobFunction? @relation(fields: [jobFunctionId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  note          String?
  createdAt     DateTime     @default(now())

  @@index([stepId])
}

// ─────────────────────────────────────────────────────────────
// Documentbeheer — SharePoint is de enige bron. Hier staan alleen
// een verwijzing en gecachete metadata, nooit het bestand zelf.
// ─────────────────────────────────────────────────────────────

model Document {
  id                String    @id @default(cuid())
  title             String
  documentNumber    String?
  sharePointDriveId String?
  sharePointItemId  String?   @unique
  webUrl            String
  fileType          String?
  status            String? // uit SharePoint-metadata (bijv. "Vrijgegeven")
  version           String? // uit SharePoint-versiegeschiedenis
  ownerName         String? // uit SharePoint-metadata
  ownerId           String?
  owner             User?     @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  revisionDate      DateTime?
  lastModifiedAt    DateTime?
  lastSyncedAt      DateTime?
  removedInSource   Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  requirements      NormRequirement[]  @relation("DocumentRequirements")
  processes         Process[]          @relation("ProcessDocuments")
  processSteps      ProcessStep[]      @relation("StepDocuments")
  legalRequirements LegalRequirement[] @relation("LegalDocuments")
}

// ─────────────────────────────────────────────────────────────
// Risico's en kansen
// ─────────────────────────────────────────────────────────────

enum RiskType {
  RISK
  OPPORTUNITY
}

/// Soort risico; SAFETY = arbo / RI&E.
enum RiskCategory {
  STRATEGIC
  QUALITY
  ENVIRONMENT
  SAFETY
  CO2
  COMPLIANCE
  OTHER
}

/// Status van de aanpak (beheersmaatregel of actie om te benutten).
enum TreatmentStatus {
  OPEN
  PLANNED
  IN_PROGRESS
  ONGOING
  DONE
}

enum RiskStatus {
  OPEN
  CONTROLLED
  CLOSED
}

model Risk {
  id               String          @id @default(cuid())
  number           Int             @unique @default(autoincrement())
  externalRef      String?         @unique // nummer uit het eigen register (bijv. R01, K12); gebruikt bij herimport
  type             RiskType        @default(RISK)
  category         RiskCategory    @default(OTHER)
  title            String
  description      String?
  cause            String?
  consequence      String?
  likelihoodBefore Int // 1–5
  impactBefore     Int // 1–5
  measures         String?
  likelihoodAfter  Int?
  impactAfter      Int?
  status           RiskStatus      @default(OPEN)
  ownerId          String?
  owner            User?           @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?           @relation("RiskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  locationId       String?
  location         Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reviewDate       DateTime?
  lastReviewedAt   DateTime? // laatst beoordeeld
  strategic        Boolean         @default(false) // ★ strategisch uit de contextanalyse (prioriteit 1)
  origin           String? // herkomst, bijv. Contextanalyse / Aanvullend
  contextFactor    String? // contextfactor uit de contextanalyse
  theme            String? // thema
  ownerText        String? // eigenaar als functie/rol, bijv. "BU-directeur Beton"
  term             String? // termijn, bijv. "Q2 2027", "Doorlopend"
  treatmentStatus  TreatmentStatus @default(OPEN) // status van de aanpak
  monitoring       String? // monitoring / KPI
  framework        String? // kader, bijv. "ISO 14001, wetgeving"
  notes            String? // opmerking
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  processes   Process[]    @relation("RiskProcesses")
  disciplines Discipline[] @relation("RiskDisciplines")

  requirements         NormRequirement[]     @relation("RiskRequirements")
  legalRequirements    LegalRequirement[]    @relation("LegalRisks")
  environmentalAspects EnvironmentalAspect[] @relation("AspectRisks")
  actions              Action[]
}

// ─────────────────────────────────────────────────────────────
// Audits (intern, extern, klant) en bevindingen
// ─────────────────────────────────────────────────────────────

enum AuditType {
  INTERNAL
  EXTERNAL
  CUSTOMER
}

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FindingClass {
  MAJOR
  MINOR
  OBSERVATION
}

enum FindingStatus {
  OPEN
  CLOSED
}

/// Resultaat per normeis op de auditchecklist.
enum ChecklistResult {
  NOT_ASSESSED
  CONFORM
  FINDING
  NOT_APPLICABLE
}

model Audit {
  id                String      @id @default(cuid())
  number            Int         @unique @default(autoincrement())
  type              AuditType
  title             String
  plannedDate       DateTime
  completedDate     DateTime?
  auditor           String?
  certificationBody String?
  scope             String?
  conclusion        String?
  reportUrl         String? // link naar het auditrapport in SharePoint
  status            AuditStatus @default(PLANNED)
  locationId        String?
  location          Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  disciplineId      String?
  discipline        Discipline? @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  norms     Norm[]               @relation("AuditNorms")
  findings  AuditFinding[]
  checklist AuditChecklistItem[]

  @@index([plannedDate])
}

/// Checklistregel: één normeis die in deze audit wordt (of is) getoetst.
model AuditChecklistItem {
  id            String          @id @default(cuid())
  auditId       String
  audit         Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   NormRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  result        ChecklistResult @default(NOT_ASSESSED)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([auditId, requirementId])
  @@index([requirementId])
}

model AuditFinding {
  id             String           @id @default(cuid())
  auditId        String
  audit          Audit            @relation(fields: [auditId], references: [id], onDelete: Cascade)
  requirementId  String?
  requirement    NormRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  number         Int // volgnummer binnen de audit
  classification FindingClass
  description    String
  rootCause      String? // oorzaakanalyse
  status         FindingStatus    @default(OPEN)
  dueDate        DateTime? // termijn voor afhandeling (bijv. eis certificatie-instelling)
  closedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  actions Action[]

  @@unique([auditId, number])
}

// ─────────────────────────────────────────────────────────────
// Acties en verbeterpunten
// ─────────────────────────────────────────────────────────────

enum ActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ActionKind {
  TASK
  CORRECTION
  CORRECTIVE
  IMPROVEMENT
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActionSource {
  MANUAL
  AUDIT
  RISK
  COMPLIANCE
  ENVIRONMENTAL_ASPECT
  CO2_REDUCTION
  LOCATION_AUDIT
  INCIDENT
  NONCONFORMITY
  MANAGEMENT_REVIEW
  OBJECTIVE
  COMPLAINT
  OTHER
}

model Action {
  id                    String               @id @default(cuid())
  number                Int                  @unique @default(autoincrement())
  title                 String
  description           String?
  source                ActionSource         @default(MANUAL)
  status                ActionStatus         @default(OPEN)
  priority              ActionPriority       @default(MEDIUM)
  ownerId               String?
  owner                 User?                @relation("ActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById           String?
  createdBy             User?                @relation("ActionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deadline              DateTime?
  completedAt           DateTime?
  result                String?
  disciplineId          String?
  discipline            Discipline?          @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  locationId            String?
  location              Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  riskId                String?
  risk                  Risk?                @relation(fields: [riskId], references: [id], onDelete: SetNull)
  findingId             String?
  finding               AuditFinding?        @relation(fields: [findingId], references: [id], onDelete: SetNull)
  legalRequirementId    String?
  legalRequirement      LegalRequirement?    @relation(fields: [legalRequirementId], references: [id], onDelete: SetNull)
  environmentalAspectId String?
  environmentalAspect   EnvironmentalAspect? @relation(fields: [environmentalAspectId], references: [id], onDelete: SetNull)
  reductionTargetId     String?
  reductionTarget       ReductionTarget?     @relation(fields: [reductionTargetId], references: [id], onDelete: SetNull)
  expectedReductionKg   Decimal?             @db.Decimal(14, 2) // verwachte CO2-reductie per jaar (kg), bij CO2-maatregelen
  co2Measure            ActionCo2?
  locationAuditAnswerId String?
  locationAuditAnswer   LocationAuditAnswer? @relation(fields: [locationAuditAnswerId], references: [id], onDelete: SetNull)
  kind                  ActionKind           @default(TASK) // taak, directe correctie, corrigerende maatregel, verbetering
  externalRef           String?              @unique // nummer uit een eigen actielijst (import)
  ownerText             String? // eigenaar als naam of functie (als die geen gebruiker is)
  reportId              String?
  report                Report?              @relation(fields: [reportId], references: [id], onDelete: SetNull)
  managementReviewId    String?
  managementReview      ManagementReview?    @relation(fields: [managementReviewId], references: [id], onDelete: SetNull)
  rootCause             String? // oorzaakanalyse (verplicht bij een corrigerende maatregel)
  objectiveId           String?
  objective             Objective?           @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  verifiedAt            DateTime? // effectiviteit gecontroleerd op
  verificationNote      String? // uitkomst controle effectiviteit
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  requirements NormRequirement[] @relation("ActionRequirements")

  @@index([status, deadline])
  @@index([ownerId])
}

// ─────────────────────────────────────────────────────────────
// Leveranciers
// ─────────────────────────────────────────────────────────────

enum SupplierStatus {
  NEW
  APPROVED
  CONDITIONAL
  REJECTED
}

model Supplier {
  id           String         @id @default(cuid())
  name         String
  category     String?
  contactName  String?
  email        String?
  phone        String?
  critical     Boolean        @default(false)
  status       SupplierStatus @default(NEW)
  notes        String?
  disciplineId String?
  discipline   Discipline?    @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  evaluations SupplierEvaluation[]
}

model SupplierEvaluation {
  id                 String    @id @default(cuid())
  supplierId         String
  supplier           Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  date               DateTime
  quality            Int // 1–5
  delivery           Int // 1–5
  price              Int // 1–5
  safety             Int // 1–5
  environment        Int? // 1–5
  remarks            String?
  nextEvaluationDate DateTime?
  evaluatedById      String?
  evaluatedBy        User?     @relation(fields: [evaluatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// Stakeholders (belanghebbenden)
// ─────────────────────────────────────────────────────────────

enum StakeholderType {
  INTERNAL
  EXTERNAL
}

model Stakeholder {
  id             String                  @id @default(cuid())
  name           String                  @unique
  type           StakeholderType         @default(EXTERNAL)
  needs          String? // eisen
  expectations   String? // wat zij van ons verwachten
  influenceLevel String? // invloed zoals in de analyse: Hoog, Midden/hoog, Midden, Toenemend
  influence      Int? // 1–5 (optioneel, voor een invloed/belang-matrix)
  interest       Int? // 1–5
  howAddressed   String? // hoe we hierop inspelen
  sortOrder      Int                     @default(0)
  active         Boolean                 @default(true)
  ownerId        String?
  owner          User?                   @relation("StakeholderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reviewDate     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  obligations    StakeholderObligation[] @relation("ObligationStakeholders")
}

/// Verwachting van belanghebbenden die we als verplichting overnemen (ISO 14001 4.2 c).
model StakeholderObligation {
  id                String              @id @default(cuid())
  stakeholderText   String // belanghebbende(n) zoals in de analyse
  obligation        String
  character         ObligationCharacter @default(LEGAL)
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  stakeholders      Stakeholder[]       @relation("ObligationStakeholders")
  legalRequirements LegalRequirement[]  @relation("ObligationLegal")

  @@unique([stakeholderText, obligation])
}

enum ObligationCharacter {
  LEGAL
  CONTRACTUAL
  VOLUNTARY
}

/// Contextfactor (ISO 9001/14001 4.1). De naam is de sleutel waarmee risico's en milieuaspecten (veld contextFactor) worden gekoppeld.
model ContextFactor {
  id            String            @id @default(cuid())
  name          String            @unique
  kind          ContextFactorKind @default(EXTERNAL)
  importance    String? // belang: Hoog, Toenemend, …
  character     String? // karakter: Risico, Kans, Risico én kans, Ontwikkelpunt, …
  ambition      String? // wat we ermee willen
  sectionNumber String? // paragraaf in de analyse, bijv. "3.1"
  sortOrder     Int               @default(0)
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

enum ContextFactorKind {
  EXTERNAL
  INTERNAL
}

/// Eén versie van de context- en stakeholderanalyse, ingelezen uit Word (tekst met afbeeldingen).
model ContextAnalysis {
  id             String                @id @default(cuid())
  title          String
  versionLabel   String? // bijv. "2026.01" of "2026–2027"
  fileName       String
  sharepointUrl  String?
  status         ContextAnalysisStatus @default(CONCEPT)
  ownerText      String? // eigenaar volgens het document (QHSE)
  reviewCycle    String? // herzieningscyclus volgens het document
  approvedByText String? // vastgesteld door (bijv. "Directie (D. Rouwmaat)")
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?                 @relation("ContextApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  nextReviewDate DateTime?
  uploadedById   String?
  uploadedBy     User?                 @relation("ContextUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  sections       ContextSection[]
  images         ContextImage[]
}

enum ContextAnalysisStatus {
  CONCEPT
  APPROVED
  SUPERSEDED
}

model ContextSection {
  id           String          @id @default(cuid())
  analysisId   String
  analysis     ContextAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  part         Int // deel (0 = voorblad en samenvatting)
  partTitle    String?
  partSubtitle String?
  partKern     String?
  number       String? // paragraafnummer, bijv. "3.1"
  title        String
  anchor       String
  html         String // opgeschoonde HTML (alleen veilige elementen)
  sortOrder    Int

  @@index([analysisId, sortOrder])
}

model ContextImage {
  id          String          @id // uuid, staat in de HTML van de secties
  analysisId  String
  analysis    ContextAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
  size        Int
  alt         String?

  @@index([analysisId])
}

// ─────────────────────────────────────────────────────────────
// Audit trail: wie heeft wat wanneer bekeken of gewijzigd
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String?
  action     String // LOGIN, VIEW, CREATE, UPDATE, DELETE, SYNC
  entityType String
  entityId   String?
  summary    String?
  details    Json?

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Wet- en regelgeving (compliance) — bindende verplichtingen
// ─────────────────────────────────────────────────────────────

enum Applicability {
  YES
  CONDITIONAL
  TO_DETERMINE
  NO
}

enum ImplementationStatus {
  IMPLEMENTED
  IN_PROGRESS
  ACTION_NEEDED
  NOT_APPLICABLE
}

enum ImpactLevel {
  HIGH
  MEDIUM
  LOW
}

enum ComplianceStatus {
  NOT_ASSESSED
  COMPLIANT
  PARTIAL
  NON_COMPLIANT
  NOT_APPLICABLE
}

enum LegalCategory {
  ENVIRONMENT
  HEALTH_SAFETY
  PRODUCT
  ENERGY_CO2
  BUILDING
  OTHER
}

/// Eén wettelijke eis of andere bindende verplichting (wet, besluit, regeling, vergunningvoorschrift, klanteis).
model LegalRequirement {
  id                   String                @id @default(cuid())
  number               Int                   @unique @default(autoincrement())
  externalRef          String?               @unique // kenmerk uit het (Excel-)bronregister; gebruikt bij herimport
  title                String // wet / regeling
  article              String? // artikel / onderdeel
  subject              String? // onderwerp
  description          String? // de eis zelf
  source               String? // bevoegd gezag / uitgever
  sourceUrl            String?
  theme                String? // thema, bijv. "Milieu & Omgeving"
  regulationType       String? // soort regelgeving: wet, besluit, regeling, EU-richtlijn, norm, …
  applicability        Applicability         @default(YES) // van toepassing
  implementationStatus ImplementationStatus? // stand van de uitvoering
  evidence             String? // bewijslast
  ownerText            String? // eigenaar en frequentie (functie/rol)
  nextStep             String? // volgende stap
  impact               ImpactLevel?
  origin               String? // herkomst, bijv. Register QHSE / Aanvulling 2026
  category             LegalCategory         @default(OTHER)
  status               ComplianceStatus      @default(NOT_ASSESSED)
  explanation          String? // toelichting op de compliancestatus
  lastReviewDate       DateTime?
  nextReviewDate       DateTime?
  reviewIntervalMonths Int                   @default(12)
  active               Boolean               @default(true)
  ownerId              String?
  owner                User?                 @relation("LegalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById          String?
  createdBy            User?                 @relation("LegalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  disciplineId         String?
  discipline           Discipline?           @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  locationId           String?
  location             Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  processes              Process[]               @relation("LegalProcesses")
  documents              Document[]              @relation("LegalDocuments")
  risks                  Risk[]                  @relation("LegalRisks")
  requirements           NormRequirement[]       @relation("LegalNormRequirements")
  norms                  Norm[]                  @relation("LegalNorms") // geldt voor (ISO 14001, CO2-prestatieladder, VCA, ISO 9001, …)
  actions                Action[]
  assessments            ComplianceAssessment[]
  environmentalAspects   EnvironmentalAspect[]   @relation("AspectLegal")
  complianceQuestions    ComplianceQuestion[]
  locationAuditAnswers   LocationAuditAnswer[]
  stakeholderObligations StakeholderObligation[] @relation("ObligationLegal")

  @@index([status])
  @@index([nextReviewDate])
}

/// Vastgelegde toetsing (evaluatie van de naleving, ISO 14001 9.1.2).
model ComplianceAssessment {
  id                 String           @id @default(cuid())
  legalRequirementId String
  legalRequirement   LegalRequirement @relation(fields: [legalRequirementId], references: [id], onDelete: Cascade)
  date               DateTime
  status             ComplianceStatus
  explanation        String?
  assessedById       String?
  assessedBy         User?            @relation(fields: [assessedById], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())

  @@index([legalRequirementId, date])
}

// ─────────────────────────────────────────────────────────────
// Milieuaspecten (ISO 14001 6.1.2)
// ─────────────────────────────────────────────────────────────

enum AspectPriority {
  HIGH
  MEDIUM
  LOW
}

enum AspectSiteType {
  SITE
  PROJECT
  GROUP
}

enum AspectType {
  AIR
  NOISE
  SOIL
  WATER
  ENERGY
  WASTE
  RESOURCES
  ODOUR
  VIBRATION
  LIGHT
  TRANSPORT
  OTHER
}

/// Normale, abnormale (bijv. opstart, onderhoud, storing) of noodsituatie.
enum OperatingSituation {
  NORMAL
  ABNORMAL
  EMERGENCY
}

/// Milieuaspect: activiteit → aspect → milieueffect, met scoring en significantie.
model EnvironmentalAspect {
  id                String             @id @default(cuid())
  number            Int                @unique @default(autoincrement())
  externalRef       String?            @unique // nummer uit het eigen register (A001); gebruikt bij herimport
  businessUnit      String? // bedrijfsonderdeel zoals in het register (Beton, Infra, Transport, Afval & Recycling, …)
  locationText      String? // locatie zoals in het register (Groenlo, Betoncentrale Rijssen, Project / werk, …)
  siteType          AspectSiteType     @default(SITE)
  inOperation       Boolean            @default(true) // status locatie: tijdelijk niet in werking telt niet mee
  activity          String // activiteit, bijv. "Op- en overslag"
  mba               String? // milieubelastende activiteit (Bal hoofdstuk 3)
  theme             String? // milieuthema (Geluid, Lucht, Bodem, …)
  aspectType        AspectType         @default(OTHER) // afgeleid van het thema
  aspect            String // milieuaspect
  impact            String? // milieueffect
  situation         OperatingSituation @default(NORMAL)
  contextFactor     String? // contextfactor uit de contextanalyse
  legalApplies      Boolean            @default(false) // wettelijke eis van toepassing
  legalText         String? // wet- en regelgeving (vrije tekst uit het register)
  stakeholders      String? // betrokken belanghebbenden
  complaints        Boolean            @default(false) // klachten bekend
  controls          String? // voorzieningen / beheersmaatregelen
  effectScore       Decimal?           @db.Decimal(6, 2) // E: effect (1, 3, 7, 15, 40)
  exposure          Decimal?           @db.Decimal(6, 2) // B: voorkomen (0,5 – 10)
  probability       Decimal?           @db.Decimal(6, 2) // W: waarschijnlijkheid (0,1 – 10)
  opportunity       Boolean            @default(false) // kans (true) of bedreiging (false)
  priority          AspectPriority? // eigen weging H/M/L; H of M = significant
  priorityRationale String? // onderbouwing prio (bij afwijking van het risiconiveau)
  lcRawMaterials    Int? // levenscyclus: grondstofwinning (1–3, leeg = n.v.t.)
  lcDesign          Int? // ontwerp
  lcProduction      Int? // productie
  lcTransport       Int? // transport
  lcUse             Int? // gebruik
  lcEndOfLife       Int? // einde levensduur
  lcDisposal        Int? // definitieve verwijdering
  lifecycleSource   String? // bron levenscyclus: MAR 2025 / Concept 2026 / Vastgesteld
  measure           String? // maatregel / doelstelling uit het register
  ownerText         String? // eigenaar als functie
  origin            String? // herkomst (MAR 2025, Aanvulling 2026, …)
  co2Relevant       Boolean            @default(false) // energie / emissies → CO2-prestatieladder
  significant       Boolean            @default(false) // prio hoog of middel; opgeslagen voor filteren
  reviewDate        DateTime? // volgende beoordeling
  active            Boolean            @default(true)
  ownerId           String?
  owner             User?              @relation("AspectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?              @relation("AspectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  disciplineId      String?
  discipline        Discipline?        @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  locationId        String?
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  processes         Process[]          @relation("AspectProcesses")
  risks             Risk[]             @relation("AspectRisks")
  legalRequirements LegalRequirement[] @relation("AspectLegal")
  requirements      NormRequirement[]  @relation("AspectNormRequirements")
  actions           Action[]

  @@index([significant])
}

/// Instellingen die QHSE in de app beheert (sleutel → waarde).
model AppSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

// ─────────────────────────────────────────────────────────────
// CO2-prestatieladder: energiedragers, emissiefactoren, verbruik, doelstellingen
// ─────────────────────────────────────────────────────────────

enum EnergyCategory {
  FUEL
  ELECTRICITY
  GAS
  HEAT
  TRAVEL
  TRANSPORT
  OTHER
}

/// Energiedrager / emissiebron, bijv. "Diesel (B7)", "Elektriciteit grijs", "Aardgas".
/// Organisatie binnen de CO2-footprint (bijv. Rouwmaat, Mombarg) met het aandeel binnen de organisatiegrens.
model Co2Organisation {
  id           String              @id @default(cuid())
  name         String              @unique
  boundaryPct  Decimal             @default(100) @db.Decimal(6, 2)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  consumptions EnergyConsumption[]
  kpis         Co2Kpi[]
}

/// Kengetal per jaar voor de intensiteit (bijv. aantal FTE, omzet).
model Co2Kpi {
  id             String           @id @default(cuid())
  year           Int
  kind           String // FTE | REVENUE | KM | OTHER
  label          String?
  value          Decimal          @db.Decimal(18, 4)
  organisationId String?
  organisation   Co2Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  source         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([year, kind, organisationId])
}

/// Datakwaliteitsmanagementplan (DKMP): per emissiestroom waar de data vandaan komt, wie, wanneer, onzekerheden en verbeterplan.
model DataQualityItem {
  id             String         @id @default(cuid())
  section        String // groep, bijv. "Aardgasverbruik", "Brandstof wagenpark"
  stream         String // emissiestroom of aansluiting, bijv. "Den Sliem 74"
  carrierId      String?
  carrier        EnergyCarrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  unit           String?
  source         String? // bron (systeem, leverancier)
  dataOwner      String? // brondata van
  executor       String? // uitvoerder
  requestPeriod  String? // datum/periode uitvraag
  analysisPeriod String? // datum/periode analyse
  deviation      String? // afwijking + oplossing
  uncertainty    String? // onzekerheden en impact
  improvement    String? // verbeterplan datakwaliteit
  qualityScore   Int? // 1–5
  lastCheckedAt  DateTime?
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([section, stream])
}

/// CO2-gegevens bij een maatregel (actie) uit het plan van aanpak.
model ActionCo2 {
  id                  String         @id @default(cuid())
  actionId            String         @unique
  action              Action         @relation(fields: [actionId], references: [id], onDelete: Cascade)
  streamGroup         String? // bijv. "Scope 1 - Brandstofverbruik"
  carrierId           String? // emissiestroom waarop de reductie wordt berekend
  carrier             EnergyCarrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  reductionPct        Decimal?       @db.Decimal(8, 4) // reductie op de emissiestroom (%)
  energyReductionPct  Decimal?       @db.Decimal(8, 4) // reductie op energie (%) van die stroom
  measureType         String? // type maatregel
  skao                String? // SKAO of eigen maatregel
  skaoCategory        String? // A / B / C
  term                String? // korte / middellange / lange termijn
  planning            String?
  knowledgeNeed       String?
  progressNote        String? // voortgang (status update) per jaar
  trl                 String?
  flexibilityImpact   String?
  investment          String?
  legislation         String?
  resources           String? // benodigde middelen / voorbereidende acties
  valueChain          String? // toepassing op waardeketen
  currentYearActions  String? // actiepunten huidig jaar
  tenderAdvantage     String? // van toepassing op project met gunningvoordeel
  notApplicableReason String?
  deadlineText        String? // deadline zoals in het plan van aanpak ("2025", "Doorlopend")
  indication          String? // kolom 'indicatie' uit de PVA-berekening
  sortOrder           Int            @default(0) // volgorde zoals in het plan van aanpak
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model EnergyCarrier {
  id            String         @id @default(cuid())
  name          String         @unique
  aliases       String? // alternatieve namen (komma-gescheiden), voor herkenning bij import
  unit          String // liter, kWh, m3, km, kg, GJ
  category      EnergyCategory @default(OTHER)
  defaultScope  Int            @default(1) // 1, 2 of 3
  energyPerUnit Decimal?       @db.Decimal(14, 8) // GJ per eenheid (energiebalans); aanpasbaar
  reportGroup   String? // groep in het overzicht, bijv. "Brandstofverbruik wagenpark" (leeg = afgeleid uit de naam)
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  factors      EmissionFactor[]
  consumptions EnergyConsumption[]
  equipment    Equipment[]
  dataQuality  DataQualityItem[]
  co2Measures  ActionCo2[]
}

/// Emissiefactor (kg CO2-equivalent per eenheid), geldig vanaf een datum. De berekening gebruikt de factor die gold bij het verbruik.
model EmissionFactor {
  id        String        @id @default(cuid())
  carrierId String
  carrier   EnergyCarrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  factor    Decimal       @db.Decimal(14, 6) // kg CO2e per eenheid — well-to-wheel (WTW)
  wtt       Decimal?      @db.Decimal(14, 6) // well-to-tank (kg per eenheid); informatief, scope 3 cat. 3
  ttw       Decimal?      @db.Decimal(14, 6) // tank-to-wheel (kg per eenheid)
  biogenic  Decimal?      @db.Decimal(14, 6) // biogene emissies (kg per eenheid), apart gerapporteerd
  validFrom DateTime
  source    String? // bijv. "CO2emissiefactoren.nl, lijst januari 2026"
  notes     String?
  createdAt DateTime      @default(now())

  @@unique([carrierId, validFrom])
}

/// Materieel (voertuigen, machines, installaties).
model Equipment {
  id               String         @id @default(cuid())
  name             String
  code             String?        @unique // kenteken / machinenummer
  type             String? // bijv. shovel, vrachtwagen, generator
  defaultCarrierId String?
  defaultCarrier   EnergyCarrier? @relation(fields: [defaultCarrierId], references: [id], onDelete: SetNull)
  disciplineId     String?
  discipline       Discipline?    @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  locationId       String?
  location         Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  vehicleType      String? // TRUCK | VAN | CAR | MACHINE | OTHER (wagenpark)
  fuelType         String? // ELECTRIC | HYBRID | DIESEL | HVO | PETROL | GAS | HYDROGEN | OTHER
  euroClass        String? // ELECTRIC | EURO6 … EURO0 (milieuclassificatie)
  brand            String?
  model            String?
  buildYear        Int?
  inServiceFrom    DateTime?
  inServiceUntil   DateTime?
  notes            String?
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  consumptions EnergyConsumption[]
}

/// Verbruik van een energiedrager over een periode (begin t/m eind, inclusief).
model EnergyConsumption {
  id             String           @id @default(cuid())
  externalRef    String?          @unique // kenmerk uit het bronbestand; gebruikt bij herimport
  carrierId      String
  carrier        EnergyCarrier    @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  quantity       Decimal          @db.Decimal(18, 4) // in de eenheid van de energiedrager
  periodStart    DateTime
  periodEnd      DateTime
  scope          Int? // afwijkende scope (anders die van de energiedrager)
  description    String? // bijv. factuurnummer, leverancier
  disciplineId   String?
  discipline     Discipline?      @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  locationId     String?
  location       Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  equipmentId    String?
  equipment      Equipment?       @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  organisationId String?
  organisation   Co2Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  sourceRef      String? // brongegevens (bestandsnaam, factuur)
  locationText   String? // vestiging als tekst (als die niet aan een vestiging te koppelen is)
  createdById    String?
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([periodStart])
  @@index([carrierId])
}

/// Reductiedoelstelling, bijv. "Scope 1: −20 % in 2030 t.o.v. 2024".
model ReductionTarget {
  id           String      @id @default(cuid())
  title        String
  description  String?
  scope        Int? // 1, 2, 3 of leeg = totaal
  baseYear     Int
  baselineKg   Decimal?    @db.Decimal(16, 2) // handmatig basisjaar (anders berekend uit het verbruik)
  targetYear   Int
  reductionPct Decimal     @db.Decimal(6, 2)
  disciplineId String?
  discipline   Discipline? @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  measures   Action[]
  objectives Objective[]
}

// ── Compliance-audit per vestiging ─────────────────────────────
// Vragenbank (auditvragen, meestal gekoppeld aan een wettelijke eis) die per vestiging wordt langsgelopen.

model ComplianceQuestion {
  id                 String            @id @default(cuid())
  question           String
  evidenceHint       String? // bewijs om te bekijken
  theme              String?
  legalRequirementId String?
  legalRequirement   LegalRequirement? @relation(fields: [legalRequirementId], references: [id], onDelete: SetNull)
  sortOrder          Int               @default(0)
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  answers LocationAuditAnswer[]

  @@index([legalRequirementId])
}

model LocationAudit {
  id          String      @id @default(cuid())
  number      Int         @unique @default(autoincrement())
  locationId  String
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  date        DateTime
  status      AuditStatus @default(PLANNED)
  auditorId   String?
  auditor     User?       @relation("LocationAuditAuditor", fields: [auditorId], references: [id], onDelete: SetNull)
  auditorText String? // auditor als tekst (bijv. extern of uit import)
  notes       String?
  createdById String?
  createdBy   User?       @relation("LocationAuditCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  answers LocationAuditAnswer[]

  @@index([locationId, date])
}

/// Antwoord per vraag; vraagtekst, bewijs en eis worden bij het aanmaken overgenomen (blijft bewijs, ook als de vragenbank later wijzigt).
model LocationAuditAnswer {
  id                 String              @id @default(cuid())
  auditId            String
  audit              LocationAudit       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  questionId         String?
  question           ComplianceQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  legalRequirementId String?
  legalRequirement   LegalRequirement?   @relation(fields: [legalRequirementId], references: [id], onDelete: SetNull)
  questionText       String
  evidenceHint       String?
  theme              String?
  sortOrder          Int                 @default(0)
  verdict            ComplianceStatus    @default(NOT_ASSESSED)
  finding            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  actions Action[]

  @@unique([auditId, questionId])
  @@index([legalRequirementId])
}

// ── Meldingen: afwijkingen, klachten, ongevallen en incidenten (ISO 9001/14001 10.2, VCA, SCL) ──

enum ReportType {
  NONCONFORMITY
  COMPLAINT
  ACCIDENT
  NEAR_MISS
  UNSAFE_SITUATION
  ENVIRONMENTAL_INCIDENT
  DAMAGE
  IMPROVEMENT
  OTHER
}

enum ReportOrigin {
  INTERNAL
  CUSTOMER
  SUPPLIER
  EXTERNAL_AUDIT
  AUTHORITY
  NEIGHBOUR
  OTHER
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
  SEVERE
}

enum ReportStatus {
  NEW
  IN_PROGRESS
  CLOSED
  REJECTED
}

/// Verzuim na letsel (vinkjes bij een melding).
enum AbsenceClass {
  SHORT // letsel / verzuim 1 t/m 15 dagen
  LONG // verzuim meer dan 15 dagen
}

enum InjuryLevel {
  NONE
  FIRST_AID
  MEDICAL
  LOST_TIME
  PERMANENT
  FATAL
}

model Report {
  id                     String          @id @default(cuid())
  number                 Int             @unique @default(autoincrement())
  externalRef            String?         @unique // nummer uit een eigen register (import)
  type                   ReportType
  origin                 ReportOrigin    @default(INTERNAL)
  title                  String
  description            String?
  occurredAt             DateTime // datum (en tijd) van het voorval
  reporterText           String? // melder (naam), als het geen gebruiker is
  reportedById           String?
  reportedBy             User?           @relation("ReportReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  locationId             String?
  location               Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationText           String? // bijv. project of werkadres
  disciplineId           String?
  discipline             Discipline?     @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  processId              String?
  process                Process?        @relation(fields: [processId], references: [id], onDelete: SetNull)
  severity               ReportSeverity?
  immediateAction        String? // directe maatregel / correctie
  injury                 InjuryLevel? // bij ongevallen
  lostDays               Int? // verzuimdagen
  accidentCategory       String? // soort ongeval (val van hoogte, beknelling, …), zie ACCIDENT_CATEGORIES
  absence                AbsenceClass? // letsel met verzuim: 1–15 dagen of meer dan 15 dagen
  reportable             Boolean         @default(false) // meldplichtig (Arbeidsinspectie / bevoegd gezag)
  reportedToAuthorityAt  DateTime?
  rootCause              String? // oorzaakanalyse
  rootCauseMethod        String? // bijv. 5x waarom, visgraat, Tripod
  causeCategory          String? // mens, materieel, methode, omgeving, organisatie
  costs                  Decimal?        @db.Decimal(12, 2) // faalkosten (EUR)
  ownerId                String? // behandelaar
  owner                  User?           @relation("ReportOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerText              String?
  status                 ReportStatus    @default(NEW)
  effective              Boolean? // effectiviteit van de maatregelen
  effectivenessNote      String?
  effectivenessCheckedAt DateTime?
  closingNote            String? // toelichting bij afsluiten of afwijzen
  closedAt               DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  actions      Action[]
  requirements NormRequirement[] @relation("ReportRequirements")

  @@index([type, status])
  @@index([occurredAt])
}

// ─────────────────────────────────────────────────────────────
// Directiebeoordeling (managementreview) — dia's in het template van Rouwmaat
// ─────────────────────────────────────────────────────────────

enum ReviewStatus {
  CONCEPT
  APPROVED
}

/// Managementreview: een reeks dia's (opbouw en opmaak uit het eigen PowerPoint-template), bewerkbaar tot vaststelling.
model ManagementReview {
  id           String       @id @default(cuid())
  number       Int          @unique @default(autoincrement())
  title        String // bijv. "Managementreview 2025"
  year         Int // beoordelingsjaar
  status       ReviewStatus @default(CONCEPT)
  meetingDate  DateTime?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?        @relation("ReviewApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  logoImageId  String? // logo op de dia's
  stripImageId String? // standaard fotostrook links op de inhoudsdia's (per dia te kiezen)
  footerText   String? // voettekst op de inhoudsdia's, bijv. "Managementreview 2025 · actualisatie 2026"
  basedOnId    String? // vorige review waarvan deze een kopie is
  notes        String?
  createdById  String?
  createdBy    User?        @relation("ReviewCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  slides  ReviewSlide[]
  actions Action[]
}

/// Eén dia. `layout` bepaalt de opbouw; `data` bevat de elementen (kaarten, kengetallen, tabel, grafiek, …) met hun positie in inches.
model ReviewSlide {
  id        String           @id @default(cuid())
  reviewId  String
  review    ManagementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  order     Int
  layout    String // TITLE | CHAPTER | CONTENT | CONCLUSION
  kicker    String? // rode regel boven de titel, bijv. "01 · RESULTATEN VOORGAANDE DOELSTELLINGEN"
  title     String
  data      Json
  imageId   String? // foto (titel-, hoofdstuk- of conclusiedia) of fotostrook (inhoudsdia)
  hidden    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([reviewId, order])
}

/// Afbeeldingen voor de directiebeoordeling (foto's, logo, iconen); gedeeld tussen reviews.
model ReviewImage {
  id        String   @id @default(uuid())
  role      String // photo | strip | logo | icon
  name      String?
  hash      String   @unique // sha-256 van de inhoud (geen dubbele opslag)
  mime      String
  width     Int?
  height    Int?
  data      Bytes
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Doelstellingen (ISO 9001 §6.2, ISO 14001 §6.2, VCA, CO2-prestatieladder)
// ─────────────────────────────────────────────────────────────

enum ObjectiveCategory {
  STRATEGIC
  QUALITY
  CUSTOMER
  ENVIRONMENT
  CO2
  SAFETY
  HEALTH
  PEOPLE
  COMPLIANCE
  OTHER
}

/// Status van een doelstelling; verandert alleen via een beoordeling (ObjectiveReview).
enum ObjectiveStatus {
  NOT_ASSESSED
  ON_TRACK
  AT_RISK
  OFF_TRACK
  ACHIEVED
  PARTIAL
  NOT_ACHIEVED
  CANCELLED
}

/// Doelstelling (code D-001), SMART: indicator, nulmeting, streefwaarde, eigenaar en termijn.
model Objective {
  id                   String            @id @default(cuid())
  number               Int               @unique @default(autoincrement())
  externalRef          String?           @unique
  title                String
  description          String?
  category             ObjectiveCategory
  indicator            String? // KPI / meetmethode
  acceptance           String? // SMART – Acceptabel: afgestemd met / draagvlak
  feasibility          String? // SMART – Realistisch: onderbouwing haalbaarheid, middelen
  baselineText         String? // nulmeting als tekst, bijv. "IF 4,5 (2024)"
  targetText           String? // streefwaarde als tekst, bijv. "IF ≤ 3,8"
  unit                 String? // eenheid bij de getallen, bijv. "%", "t CO2", "IF"
  baselineValue        Decimal?          @db.Decimal(16, 4)
  targetValue          Decimal?          @db.Decimal(16, 4)
  currentValue         Decimal?          @db.Decimal(16, 4) // laatste gemeten waarde (uit de beoordeling)
  startDate            DateTime?
  deadline             DateTime?
  termText             String? // termijn als tekst, bijv. "Per kwartaal"
  ownerId              String?
  owner                User?             @relation("ObjectiveOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerText            String?
  disciplineId         String?
  discipline           Discipline?       @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  reductionTargetId    String?
  reductionTarget      ReductionTarget?  @relation(fields: [reductionTargetId], references: [id], onDelete: SetNull)
  status               ObjectiveStatus   @default(NOT_ASSESSED)
  lastReviewDate       DateTime?
  nextReviewDate       DateTime?
  reviewIntervalMonths Int               @default(3)
  active               Boolean           @default(true)
  createdById          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  norms        Norm[]            @relation("ObjectiveNorms")
  requirements NormRequirement[] @relation("ObjectiveRequirements")
  reviews      ObjectiveReview[]
  actions      Action[]

  @@index([category, status])
}

/// Beoordeling van de voortgang (historie = bewijs); de meest recente bepaalt de status.
model ObjectiveReview {
  id           String          @id @default(cuid())
  objectiveId  String
  objective    Objective       @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  date         DateTime
  status       ObjectiveStatus
  currentValue Decimal?        @db.Decimal(16, 4)
  progressPct  Int? // handmatige voortgang 0–100 als er geen getallen zijn
  explanation  String? // oorzaak en vervolg
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())

  @@index([objectiveId, date])
}

/// Samenstelling van het wagenpark: aantal voertuigen per jaar, soort voertuig en brandstoftype (CO2-prestatieladder, figuur brandstoftypes).
model FleetCount {
  id          String   @id @default(cuid())
  year        Int
  vehicleType String // TRUCK | VAN | CAR | MACHINE | OTHER
  kind        String   @default("FUEL") // FUEL = brandstoftype, EURO = milieuclassificatie
  value       String // FUEL: ELECTRIC | HYBRID | DIESEL | … ; EURO: ELECTRIC | EURO6 … EURO0
  count       Int
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year, vehicleType, kind, value])
}
