{
  "name": "rouwmaat-ims",
  "version": "0.1.0",
  "private": true,
  "description": "Integraal Managementsysteem (IMS) Rouwmaat Groep",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:local": "next start -H 127.0.0.1",
    "backup": "tsx scripts/backup.ts maak",
    "backup:test": "tsx scripts/backup.ts test",
    "backup:lijst": "tsx scripts/backup.ts lijst",
    "backup:herstel": "tsx scripts/backup.ts herstel",
    "backup:plan": "tsx scripts/backup-plan.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/fira-sans": "5.3.0",
    "@prisma/client": "6.19.3",
    "dom-serializer": "3.1.1",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0",
    "mammoth": "1.13.0",
    "next": "15.5.29",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.20",
    "sanitize-html": "2.18.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.7",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "prettier": "3.10.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.33",
    "effect": "3.22.5",
    "deepmerge-ts": "8.0.2"
  }
}
