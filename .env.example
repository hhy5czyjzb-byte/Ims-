# Kopieer naar .env en vul in. .env staat in .gitignore en mag NOOIT worden gecommit.

# --- Database ---
DATABASE_URL="postgresql://ims:ims@localhost:5432/ims?schema=public"

# --- NextAuth ---
# Genereer met: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Microsoft Entra ID (app-registratie in de Rouwmaat-tenant) ---
AZURE_AD_TENANT_ID=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""

# Object-ID's van de Entra ID-beveiligingsgroepen die de rol bepalen.
# Rechten worden in Microsoft 365 beheerd, niet in de app.
ENTRA_GROUP_QHSE=""
ENTRA_GROUP_DIRECTIE=""
ENTRA_GROUP_MIDDENKADER=""

# --- SharePoint (documentbeheer, via Microsoft Graph met het token van de gebruiker) ---
# Site-ID en drive-ID van de bibliotheek "IMS-documenten". Zie README voor opzoeken.
SHAREPOINT_SITE_ID=""
SHAREPOINT_DRIVE_ID=""

# --- Inlogmodus ---
# "local": geen inlogscherm (fase 1, laptop). Je werkt als LOCAL_USER_NAME met de rol QHSE;
#          via "Bekijken als" in het menu kijk je mee met andere rollen. Alleen bereikbaar via localhost.
# "entra": inloggen met Microsoft 365 (vul dan de AZURE_AD_* en ENTRA_GROUP_* hierboven in).
# Leeg: "entra" als Microsoft 365 is ingesteld, anders "local".
AUTH_MODE="local"
LOCAL_USER_NAME="Eelco"
